# Copy this file to apps/web/.env.local and adjust for your Supabase project.
#
# Local Supabase stack (supabase start):
# Get the anon key by running `npx supabase status -o env` and copying ANON_KEY.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Hosted Supabase project:
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<project publishable/anon key>
