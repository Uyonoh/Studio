# Supabase configuration (local dev defaults)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.e30.dummy_service_role_key
SUPABASE_JWT_SECRET=super-secret-jwt-token-with-at-least-32-characters-long

# Database & Queue
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://127.0.0.1:6379/0
STORAGE_BUCKET=media

# Public API & Webhooks
PUBLIC_API_URL=http://127.0.0.1:8000
WEBHOOK_SIGNING_SECRET=local_webhook_secret_key_32_bytes_min

# AI Providers
REPLICATE_API_TOKEN=r8_test_placeholder_token
REPLICATE_WEBHOOK_SECRET=replicate_webhook_secret_test
FAL_KEY=fal_test_placeholder_key
GEMINI_API_KEY=
PROVIDER_CONCURRENCY_GOOGLE=5

# Observability & Runtime
SENTRY_DSN=
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0.1
# Comma-separated Supabase user IDs allowed to call GET /v1/admin/stats.
ADMIN_USER_IDS=
# Browser Sentry (web app). Leave blank to disable reporting locally.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=local
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=INFO
ENVIRONMENT=local

# Limits & Abuse Controls
MAX_ACTIVE_JOBS_PER_WORKSPACE=5
MAX_PROMPT_CHARS=4000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SUBMIT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
